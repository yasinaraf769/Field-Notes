# ============================================================
# Field Notes Backend — Environment Variable Reference
# Copy this file to .env and fill in the real values.
# NEVER commit a .env file with real secrets to version control.
# ============================================================

# --- Neon PostgreSQL ---
# For the application (Hikari pool), use the POOLER endpoint:
#   jdbc:postgresql://<project>.pooler.neon.tech/<db>?sslmode=require
# For Flyway migrations ONLY, use the DIRECT (non-pooler) endpoint:
#   jdbc:postgresql://<project>.neon.tech/<db>?sslmode=require
# Flyway must use the direct endpoint because the pooler endpoint
# does not support SET commands needed by some Flyway operations.
# If you are using a single DB_URL for both, use the direct endpoint.
DB_URL=jdbc:postgresql://<project>.neon.tech/<database>?sslmode=require
DB_USERNAME=<your_neon_username>
DB_PASSWORD=<your_neon_password>

# --- JWT ---
# Must be at least 32 random characters. Use a secrets manager in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes-before-use
JWT_EXPIRATION_MS=3600000

# --- Server port ---
# Render/Railway/Fly.io inject PORT automatically. Override only if self-hosting.
PORT=8080

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# In production, set this to your Flutter web or mobile gateway origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
