							"raw": "{{baseUrl}}/actuator/health",
							"host": ["{{baseUrl}}"],
							"path": ["actuator", "health"]
						}
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "1. Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"Password123!\",\n    \"firstName\": \"Alex\",\n    \"lastName\": \"Smith\",\n    \"phone\": \"+1-555-0199\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/fieldnotesatl/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "fieldnotesatl", "auth", "register"]
						}
					}
				},
				{
					"name": "2. Login (Auto-saves Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const data = pm.response.json();",
									"    pm.collectionVariables.set(\"token\", data.accessToken);",
									"    console.log(\"Token saved:\", data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/fieldnotesatl/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "fieldnotesatl", "auth", "login"]
						}
					}
				}
			]
		},
